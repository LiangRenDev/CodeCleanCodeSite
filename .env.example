# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# Set the real values with `wrangler secret put` before production email or chat works.

# Resend API key used by POST /api/contact
# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form messages. Override the default in wrangler.jsonc if needed.
# CONTACT_EMAIL=admin@codecleancode.com

# Optional assistant. Leave blank until you have an endpoint.
# The site stays up either way; the chat widget says it is not connected.
LLM_API_KEY=
# LLM_API_BASE=https://example.com/v1
# LLM_MODEL=your-model-name
